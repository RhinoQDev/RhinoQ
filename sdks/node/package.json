{
  "name": "@rhinoq/node",
  "version": "0.1.0-beta.12",
  "description": "Open-source async Task platform for PostgreSQL queues and BullMQ with a Task API, realtime UI and safe recovery",
  "keywords": [
    "background-jobs",
    "async-tasks",
    "task-queue",
    "job-queue",
    "postgresql-queue",
    "bullmq",
    "nodejs",
    "nestjs",
    "job-progress",
    "sse",
    "job-dashboard",
    "task-management",
    "reconciliation"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madebyduy/RhinoQ.git",
    "directory": "sdks/node"
  },
  "homepage": "https://github.com/madebyduy/RhinoQ/blob/main/docs/start-here.md",
  "bugs": {
    "url": "https://github.com/madebyduy/RhinoQ/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "import": "./dist/nest.js",
      "require": "./dist/cjs/nest.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/cjs/browser.js"
    },
    "./react": {
      "types": "./dist/react-entry.d.ts",
      "import": "./dist/react-entry.js",
      "require": "./dist/cjs/react-entry.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq-entry.d.ts",
      "import": "./dist/bullmq-entry.js",
      "require": "./dist/cjs/bullmq-entry.js"
    },
    "./sqs": {
      "types": "./dist/sqs-entry.d.ts",
      "import": "./dist/sqs-entry.js",
      "require": "./dist/cjs/sqs-entry.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/cjs/server.js"
    },
    "./openapi.json": "./dist/openapi.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "rhinoq": "dist/cli/rhinoq.js",
    "rhinoq-task": "dist/cli/task-migrate.js",
    "rhinoq-task-check": "dist/cli/task-check.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs && node scripts/build-contracts.mjs && node scripts/build-info.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs test/*.test.cjs",
    "benchmark": "npm run build && node bench/task-benchmark.mjs",
    "benchmark:postgres": "npm run build && node bench/postgres-benchmark.mjs",
    "prepack": "npm run build",
    "pack": "node scripts/pack.mjs",
    "pack:check": "npm pack --dry-run",
    "verify:installed": "node scripts/verify-installed.mjs",
    "contract:check": "node scripts/build-contracts.mjs --check",
    "fault:check": "node scripts/verify-fault-matrix.mjs",
    "release:check": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "pg": "^8.22.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "pg": ">=8.11.0"
  }
}
