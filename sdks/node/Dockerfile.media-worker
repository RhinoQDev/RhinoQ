# Production base for a Node worker that uses context.media.*.
FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /work \
 && chown node:node /work
ENV NODE_ENV=production \
    RHINOQ_FFMPEG_PATH=/usr/bin/ffmpeg \
    RHINOQ_MEDIA_WORK_DIR=/work
WORKDIR /app
USER node
# Copy/install the adopter worker below or use this file as the final-stage base.
CMD ["ffmpeg", "-version"]
